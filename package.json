{
  "name": "unischeduler",
  "version": "1.0.0",
  "private": true,
  "description": "UniScheduler - Sistema de Generación Óptima de Horarios Académicos",
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:all": "cd backend && npm test && cd ../frontend && npm test",
    "lint": "eslint backend/ frontend/src/",
    "lint:fix": "eslint backend/ frontend/src/ --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\"",
    "seed": "cd backend && npm run seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "eslint": "^10.5.0",
    "prettier": "^3.8.4"
  }
}
